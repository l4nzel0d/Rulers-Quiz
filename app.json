{
  "expo": {
    "name": "Rulers Quiz",
    "slug": "us-presidents-quiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uspresidentsquiz",
    "userInterfaceStyle": "light",
    "backgroundColor": "#e8e3d6",
    "ios": {
      "bundleIdentifier": "com.borvas.uspresidentsquiz",
      "supportsTablet": true
    },
    "android": {
      "package": "com.borvas.uspresidentsquiz",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e8e3d6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "450fe6d6-74c7-4158-829f-07ea9f24d3c1"
      }
    },
    "owner": "l4nzel0ds-team"
  }
}
